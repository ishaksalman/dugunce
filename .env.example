# --- Supabase ---------------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnızca sunucu tarafında kullanılır. İstemciye ASLA sızmamalı.
SUPABASE_SERVICE_ROLE_KEY=

# Seed ve migration için. Project Settings → Database → Connection string
DATABASE_URL=

# --- Uygulama ---------------------------------------------------------------
# Kanonik adresler, sitemap ve robots.txt buradan üretiliyor.
# Üretimde: https://dugunce.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Teklif talebi hız sınırında IP'yi hash'lemek için. Rastgele uzun bir değer:
#   openssl rand -hex 32
# Ham IP hiçbir yerde saklanmıyor.
IP_HASH_SALT=


# --- DavetPro entegrasyonu ---------------------------------------------------
# İki tarafta AYNI değer olmalı.  openssl rand -hex 32
DAVETPRO_INTEGRATION_SECRET=
DAVETPRO_URL=http://localhost:3002

# Aktarım kuyruğunu işleyen zamanlanmış görevin yetki anahtarı.
CRON_SECRET=

# --- Talep bildirimi (Telegram) ----------------------------------------------
# Sahiplenilmemiş bir mekana talep geldiğinde admin'e anlık bildirim —
# işletmeye otomatik mesaj ATILMIYOR (izinsiz ticari ileti KVKK/İYS'ye aykırı),
# ilk temas admin tarafından kişisel olarak kuruluyor. Bkz. lib/telegram.ts.
# İkisi de boşsa bildirim sessizce atlanır, talep akışı hiç etkilenmez.
#   1) @BotFather'a yaz, /newbot ile bot oluştur → token
#   2) Botla bir kere konuş, sonra https://api.telegram.org/bot<token>/getUpdates
#      adresinden kendi chat_id'ni oku
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
