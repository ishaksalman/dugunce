# --- Supabase ---------------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnızca sunucu tarafında kullanılır. İstemciye ASLA sızmamalı.
SUPABASE_SERVICE_ROLE_KEY=

# Seed ve migration için. Project Settings → Database → Connection string
DATABASE_URL=

# --- Uygulama ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Teklif talebi hız sınırında IP'yi hash'lemek için. Rastgele uzun bir değer:
#   openssl rand -hex 32
# Ham IP hiçbir yerde saklanmıyor.
IP_HASH_SALT=

# GEÇİCİ: Supabase bağlanana kadar üretim build doğrulaması için.
# Sunucuyu bu bayrakla ayağa kaldırmayın. Supabase gelince silinecek.
# DAVETMEKANI_ALLOW_DEV_DB=1
